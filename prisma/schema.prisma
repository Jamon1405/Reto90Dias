generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TitanDay {
  date        String   @id
  tsUpdated   DateTime @updatedAt
  weight      Float    @default(0)
  waist       Float    @default(0)
  workout     String   @default("")
  calIn       Int      @default(0)
  calOut      Int      @default(0)
  water       Int      @default(0)
  suppsJson   Json     @default("{}")
  macrosJson  Json     @default("{}")
  fastHours   Float    @default(0)
  steps       Int      @default(0)
  notes       String   @default("")
  activityJson Json    @default("{}")
  titanScore  Int      @default(0)
  flagsJson   Json     @default("{}")
}

model TitanState {
  key   String @id
  value String
  updatedAt DateTime @updatedAt
}
